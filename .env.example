# Cognito (same pool as Tekkzy frontend)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=

# DynamoDB
PROFILE_TABLE_NAME=beta_user_profile
PAYMENT_TABLE_NAME=beta_payment
SITE_TABLE=beta_site_table
BETA_TEMPLATE_TABLE=beta_tekkzy_template

# Domain / hosting
HOSTED_ZONE_ID=
SITE_DEPLOY_BUCKET=beta-template-site-tekkzy
TEMPLATE_ASSETS_BUCKET=institution-utils
TEMPLATE_ASSETS_BUCKET_REGION=us-east-1
TEKKZY_DOMAIN_GRACE_DAYS=7

# Custom domain registration = AWS TLD price (USD) + markup, converted to INR
DOMAIN_MARKUP_USD=5
USD_TO_INR_RATE=86


# Razorpay (test)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=

# PayPal (optional legacy payment session)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
AWSAIAPP_PAYPAL_CLIENT_ID=
AWSAIAPP_PAYPAL_SECRET=

# SES contact form (shared across template sites)
# SES_FROM_EMAIL must be a verified SES identity in the deploy region
SES_FROM_EMAIL=saibedamatta@happyprancer.com
QUERY_TO_EMAIL=saibedamatta@happyprancer.com
